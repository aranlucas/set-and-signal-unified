# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
pnpm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Installable artifacts are generated locally, not source control inputs.
/artifacts/*.apk
/artifacts/*.idsig

# Installed-app E2E runs (report, traces, screenshots)
.e2e/
.e2e/results/
.e2e/cache/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
.e2e/junit.xml
.e2e/summary.md
.e2e/logs/
.e2e/videos/
