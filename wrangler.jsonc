{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-mcp",
  "main": "src/index.ts",
  "account_id": "d93c650f72e597f96785abba389b0ce4",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "799457c018b64f86a7b950b907a7118c"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://garmin-mcp.aranlucas.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
