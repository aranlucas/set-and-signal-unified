{
  "expo": {
    "name": "Fivefold",
    "slug": "fivefold-5x5",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fivefold",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#216B53",
    "android": {
      "package": "app.fivefold.lifts",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#163A2C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#216B53"
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 200,
          "backgroundColor": "#163A2C"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "WorkoutWidget",
              "displayName": "Fivefold workout",
              "description": "Your next 5\u00d75 workout, or live progress while you lift.",
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 110,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/WorkoutWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "platforms": ["android"],
    "extra": {
      "eas": {
        "projectId": "5901bc45-5617-4899-9016-14363384acec"
      }
    },
    "owner": "aranlucas"
  }
}
