{
  "name": "fivefold",
  "version": "1.3.1",
  "private": true,
  "license": "0BSD",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --target android",
    "check": "expo install --check && pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm test && pnpm run perf",
    "build": "expo export --platform android --output-dir .expo/export/android",
    "build:apk": "pnpm eas build --platform android --profile preview --local --output ./artifacts/Fivefold.apk",
    "lint": "eslint . --max-warnings=0 && oxlint",
    "eas": "pnpm dlx --allow-build=dtrace-provider --allow-build=protobufjs eas-cli@25.3.0",
    "perf": "tsx check-performance.ts",
    "perf:renders": "vitest run tests/renders.test.tsx",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "verify:apk": "tsx verify-apk.ts",
    "test:e2e:matrix": "tsx e2e-matrix.ts"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.27",
    "@set-and-signal/exercises": "workspace:*",
    "@set-and-signal/training": "workspace:*",
    "convex": "^1.49.0",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.27",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@aranlucas/oxforge": "0.3.1",
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@e2e-dev/mobile": "0.12.6",
    "@eslint/js": "^10.0.1",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "e2e": "0.23.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "test-renderer": "1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~7.1.0-dev.20261109.1",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "eslint --fix",
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern",
      "sh -c 'pnpm lint'"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
