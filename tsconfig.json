{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    "oxfmt.config.ts",
    ".cloudflare/types"
  ]
}
