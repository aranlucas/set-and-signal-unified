{
  "name": "garmin-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Official Garmin Personal API MCP on Cloudflare Workers with OAuth consent",
  "keywords": [],
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "typegen": "cf workers types",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run --project worker",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
    "build": "cf build",
    "deploy": "cf deploy",
    "smoke": "vitest run --project smoke",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.2.2",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.20",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
