{
  "name": "set-and-signal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:/\"",
    "dev:web": "API_TARGET=https://api.set-and-signal.localhost pnpm --dir web dev",
    "dev:api": "set -a && . ./web/.env.local && set +a && ORIGIN=https://set-and-signal.localhost RP_ID=set-and-signal.localhost DATA_DIR=\"$PWD/data\" portless run --name api.set-and-signal go run ./cmd/opengym-api",
    "lint": "pnpm --dir web lint",
    "lint:strict": "pnpm --dir web lint:strict",
    "format": "pnpm --dir web format",
    "format:write": "pnpm --dir web format:write",
    "typecheck": "pnpm --dir web typecheck",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --config oxfmt.config.ts --check",
    "lint:oxforge": "oxlint",
    "prepare": "husky",
    "build": "pnpm --dir web build && go build -o build/ ./cmd/...",
    "test": "vitest run --root web",
    "pretest": "go test ./... && pnpm --dir web catalog:validate",
    "dev:android": "pnpm --filter fivefold start",
    "dev:garmin": "pnpm --filter garmin-mcp dev",
    "check:android": "pnpm --filter fivefold check",
    "check:garmin": "pnpm --filter garmin-api-codegen build && pnpm --filter garmin-api-codegen test && pnpm --filter garmin-mcp check",
    "build:android": "pnpm --filter fivefold build",
    "build:garmin": "pnpm --filter garmin-mcp build",
    "check:apps": "pnpm check:shared && pnpm check:android && pnpm check:garmin",
    "check:shared": "pnpm --filter @set-and-signal/training typecheck && pnpm --filter @set-and-signal/training test"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "0.15.13",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "sh -c 'pnpm --dir web lint && pnpm check:shared && pnpm exec oxlint --config web/oxlint.policy.config.ts packages'",
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern --write"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern --write"
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
