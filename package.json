    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "private": true
}
