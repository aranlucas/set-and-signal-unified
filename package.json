{
  "name": "fivefold",
  "license": "0BSD",
  "version": "1.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.22",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-widgets": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.75",
    "@e2e-dev/mobile": "^0.12.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "e2e": "^0.21.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --target android",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run perf",
    "build:apk": "pnpm eas build --platform android --profile preview --local --output ./artifacts/Fivefold.apk",
    "lint": "eslint . --max-warnings=0",
    "eas": "pnpm dlx --allow-build=dtrace-provider --allow-build=protobufjs eas-cli@25.3.0",
    "perf": "tsx check-performance.ts"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
}
